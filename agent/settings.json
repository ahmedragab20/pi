{
  "lastChangelogVersion": "0.84.1",
  "theme": "rose-pine",
  "defaultProvider": "cursor",
  "defaultModel": "grok-4.5",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": true,
  "externalEditor": "nvim",
  "quietStartup": true,
  "defaultProjectTrust": "always",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 2,
    "baseDelayMs": 2000,
    "provider": {
      "timeoutMs": 3600000,
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "warnings": {
    "anthropicExtraUsage": true
  },
  "packages": [
    "npm:@vigolium/piolium",
    "npm:pi-tool-repair",
    "npm:pi-lens",
    "npm:@ff-labs/pi-fff",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-vim"
  ],
  "showHardwareCursor": false,
  "editorPaddingX": 1,
  "enableInstallTelemetry": false,
  "treeFilterMode": "all",
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "hidden",
  "piVim": {
    "modeColors": {
      "insert": "borderMuted",
      "normal": "borderAccent",
      "visual": "customMessageLabel",
      "ex": "warning"
    }
  }
}