{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "typeRoots": ["./extensions/node_modules/@types", "./npm/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["extensions/**/*.ts", "tests/**/*.ts"],
  "exclude": [
    "extensions/node_modules/**",
    "extensions/diffing/pi-modules.d.ts"
  ]
}
