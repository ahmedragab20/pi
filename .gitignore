# Secrets — never commit
/agent/auth.json
/agent/models-store.json

# Machine-specific / personal
/agent/trust.json

# Cursor SDK generated state (auto-maintained by cursor-lazy)
/agent/cursor-sdk.json
/agent/cursor-sdk-model-list.json
/agent/cursor-sdk-context-windows.json

# Session transcripts & pasted images
/agent/sessions/
/agent/sessions-archive/
/agent/vision/

# Efficiency extension runtime (tool dumps + global memory files)
/agent/tmp/
/agent/memory/

# Idle-wait worker runtime (logs + pids leak absolute paths)
/agent/waiting/

# Symlink to local dev checkout (leaks absolute path)
/agent/extensions/diffing

# Dev-time module resolution for extension checks (symlink to npm/node_modules)
/agent/extensions/node_modules
